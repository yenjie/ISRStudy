BEAMS: [11, -11]
BEAM_ENERGIES: 45.5938

ALPHAS(MZ): 0.1188
ORDER_ALPHAS: 1
PDF_LIBRARY: None

PARTICLE_DATA:
  11:
    Massive: true
  # Keep V0 weak decays disabled at generator level for DELPHI/ALEPH-style
  # particle-level studies where these particles are reconstructed as stable.
  310: {Stable: 1}
  3122: {Stable: 1}
  -3122: {Stable: 1}
  3112: {Stable: 1}
  -3112: {Stable: 1}
  3222: {Stable: 1}
  -3222: {Stable: 1}
  3312: {Stable: 1}
  -3312: {Stable: 1}
  3322: {Stable: 1}
  -3322: {Stable: 1}

YFS:
  MODE: ISR
  BETA: 1

EVENT_FILE_PATH: .
EVENT_OUTPUT:
  - HepMC3[@OUTPUT_BASENAME@]
HEPMC3_IO_TYPE: 2
# HEPMC3_SHORT is deliberately NOT set.  It collapses the whole final state
# onto a single vertex whose incoming particles are the two beam leptons, which
# destroys the ISR photon history and makes every photon look beam-radiated.

PROCESSES:
  - 11 -11 -> 93 93:
      Order: {QCD: 0, EW: 2}
