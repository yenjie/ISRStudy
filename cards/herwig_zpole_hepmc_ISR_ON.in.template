# Herwig 7.3 Z-pole run card: beam ISR ON.
#
# LeptonPDF is ThePEG::LeptonLeptonPDF, the O(alpha^2) soft-photon-exponentiated
# collinear QED electron structure function.  It is the same class of model as
# PYTHIA's PDF:lepton and Sherpa's PDFESherpa, so this card together with the
# ISR_OFF card forms a genuine ISR ON/OFF pair at fixed QED shower settings.
read @EECOLLIDER@

cd /Herwig/MatrixElements
insert SubProcess:MatrixElements 0 MEee2gZ2qq

cd /Herwig/Shower
set ShowerHandler:Interactions QEDQCD

# Beam ISR ON (this is also the Herwig default for e+e- beams).
set /Herwig/Particles/e-:PDF /Herwig/Partons/LeptonPDF
set /Herwig/Particles/e+:PDF /Herwig/Partons/LeptonPDF

cd /Herwig/Generators
set EventGenerator:EventHandler:LuminosityFunction:Energy @ENERGY@

create ThePEG::HepMCFile /Herwig/Analysis/HepMC HepMCAnalysis.so
set /Herwig/Analysis/HepMC:PrintEvent @N_EVENTS@
set /Herwig/Analysis/HepMC:Format GenEvent
set /Herwig/Analysis/HepMC:Units GeV_mm
insert /Herwig/Generators/EventGenerator:AnalysisHandlers 0 /Herwig/Analysis/HepMC

saverun @RUN_NAME@ EventGenerator
